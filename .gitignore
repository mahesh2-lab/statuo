# ==========================================
# Pulse Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE DATA)
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
cookies.txt

# Production Build Outputs
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Temporary & Cache Files
tmp/
temp/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
