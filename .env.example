# =========================================================================
# Statuo Deployment Environment Configuration Template
# NOTE: Copy this file to .env and populate with your own secure credentials.
# Do NOT commit your actual .env file to version control.
# =========================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=statuo_db
POSTGRES_USER=statuo_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Redis Cache & Pub/Sub
REDIS_PORT=6379

# Unified Statuo Application (Frontend + Backend API)
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_a_random_32_plus_char_secret_key_here
BETTER_AUTH_API_KEY=generate_or_set_your_auth_api_key_here
CORS_ORIGIN=http://localhost:3000
