
# 1. Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:3000

# 2. Backend Server & Network Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# 3. PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=statuo_db
POSTGRES_USER=statuo_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://statuo_user:your_secure_postgres_password_here@localhost:5432/statuo_db

# 4. Redis Cache, Pub/Sub & Distributed Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# 5. Better Auth Security & Session Management
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate_a_random_32_plus_char_secret_key_here
BETTER_AUTH_API_KEY=generate_or_set_your_auth_api_key_here

# 6. Observability & Probe Security (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=generate_a_random_32_plus_char_secret_key_here
ALLOW_LOCAL_URLS=true
